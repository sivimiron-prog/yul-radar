# Copy this file to ".env" and fill in your keys. Never share the .env file.

# --- Required: fare data (free) ---
TRAVELPAYOUTS_TOKEN=

# --- Recommended: alerts on your phone (free) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Recommended: AI review of each flagged fare (pay per use, a few cents a day) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Optional: live double-check on Google Flights (250 free checks a month) ---
SERPAPI_KEY=
MAX_GOOGLE_CHECKS_PER_SCAN=3

# --- Optional: email alerts (Gmail: use an app password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- What to look for ---
ORIGIN=YUL
CURRENCY=cad
MONTHS_AHEAD=10
# A fare this far below normal counts as a deal (0.40 = 40%)
DEAL_THRESHOLD=0.40
# A fare this far below normal counts as a likely error
ERROR_THRESHOLD=0.55
# Ignore fares above this price (0 = no limit)
MAX_PRICE=0
MIN_TRIP_DAYS=3
MAX_TRIP_DAYS=30
# en or fr
ALERT_LANGUAGE=en
# Don't repeat an alert for the same destination and month within this many days, unless the price drops 5% more
REALERT_AFTER_DAYS=3
